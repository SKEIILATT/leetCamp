# openapi-typescript still declares a peer dependency on typescript@^5.x, but
# Angular 22 pins TypeScript 6.x. This is a metadata lag, not a real
# incompatibility — openapi-typescript reads the OpenAPI JSON and emits type
# strings, it does not run the TypeScript compiler API against this project's
# source. Safe to relax peer resolution for the whole project rather than
# passing --legacy-peer-deps on every install (ng add's own internal npm call
# does not accept that flag).
legacy-peer-deps=true
