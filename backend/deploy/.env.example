# ─────────────────────────────────────────────────────────────────────────────
# deploy/.env.example — DEPLOYMENT CONFIGURATION for docker compose
#
# Copy to `deploy/.env` and fill it in. That file is git-ignored (the root
# `.gitignore` pattern `.env` matches at any depth — verify with
# `git check-ignore -v deploy/.env`). NEVER commit it.
#
#     docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d
#
# ── WHY ONE FILE AND NOT THREE ──────────────────────────────────────────────
# This file plays two roles at once, which is why it mixes variables that live
# apart inside the repository:
#
#   1. It feeds docker-compose.yml's `${...}` interpolation → the frontend's
#      VITE_* build args and the image references come from here.
#   2. It is the `env_file` of the `api` service → its runtime configuration
#      comes from here.
#
# The trust boundary does not disappear because they share a file: the VITE_*
# values are still public (they are baked into the browser bundle) and server
# secrets still may never carry that prefix. What changes is only where they are
# written on the deploying machine.
#
# One consequence worth knowing: the VITE_* values also end up inside the api
# container, where nothing reads them. The API's schema only declares `server:`
# keys and ignores what it does not recognise. Harmless noise, not a leak —
# they are public.
#
# Ownership matrix per workspace: docs/ENV_VARIABLES.md
# Deployment runbook: docs/deployment.md
# ─────────────────────────────────────────────────────────────────────────────


# ── Proxy ────────────────────────────────────────────────────────────────────
# Site address for Caddy.
#
#   :80                → plain HTTP, NO TLS. The value for local verification
#                        (http://localhost). No certificate is requested because
#                        there is no public domain to validate.
#   app.example.com    → Caddy requests a Let's Encrypt certificate over ACME
#                        HTTP-01, renews it itself, and redirects 80→443.
#
# ⚠ For the domain mode to work, two things must already be true OUTSIDE this
# file: a DNS A/AAAA record pointing at the server's IP, and ports 80 and 443
# open in the firewall. ACME HTTP-01 validates by connecting BACK on port 80 —
# if it is closed, issuance fails and the site has no HTTPS.
SITE_ADDRESS=:80


# ── Images ───────────────────────────────────────────────────────────────────
# LOCALLY, leave these as they are: they are the tags `docker compose up --build`
# gives the images it builds on this machine.
#
# ON THE SERVER, point them at the registry. ⚠ PIN THE TAG PER COMMIT (the SHA),
# never `latest`: that is what makes a rollback deterministic. `latest` points
# somewhere different after every publish, so "go back to latest" means nothing.
#   WEB_IMAGE=ghcr.io/<owner>/leetcamp-web:a1b2c3d
#   API_IMAGE=ghcr.io/<owner>/leetcamp-api:a1b2c3d
WEB_IMAGE=leetcamp-web:local
API_IMAGE=leetcamp-api:local


# ── Frontend · BUILD-TIME ────────────────────────────────────────────────────
# Nothing to configure here. `frontend/` is a standalone Angular project (not
# Vite, not the pnpm workspace) with no build-time secrets or environment
# values to bake in — its production `environment.ts` already hardcodes the
# relative path `/api/v1`, which works because web and api share a domain
# behind Caddy (same origin, no CORS). If a deployment-specific value is ever
# needed, prefer Angular's file-replacement mechanism (`fileReplacements` in
# angular.json) over reintroducing build args here.


# ── API · RUNTIME ────────────────────────────────────────────────────────────
# ⚠ SERVER SECRETS. Everything below is read by the api container at boot and
# validated by `apps/api/src/shared/config/env.ts`. None of it may ever be given
# a VITE_ prefix.
#
# NODE_ENV, PORT and ENABLE_OPENAPI_ENDPOINT are NOT here: docker-compose.yml
# sets them, because they are properties of the topology rather than of the
# installation, and changing them from this file would break the proxy's routing
# with nothing to warn you.

# Exact browser origins allowed by CORS, CSV, NO trailing slash.
# Behind a single domain this is mostly a formality, but a wrong value here is
# the kind of thing that only shows up from a real browser.
CORS_ORIGINS=https://app.example.com

# ── Database (self-hosted) ───────────────────────────────────────────────────
# Own Postgres container (see the `postgres` service in docker-compose.yml),
# not a managed provider. PERCENT-ENCODE the password if it contains
# @ : / ? # (@ = %40, : = %3A, / = %2F, ? = %3F, # = %23).
POSTGRES_USER=leetcamp
POSTGRES_PASSWORD=<tu-password-aquí>
POSTGRES_DB=leetcamp

# No pooler in front: same host (the "postgres" service name, resolved over the
# compose internal network), same port, both variables identical. If a pooler
# (e.g. PgBouncer) is ever added in front, DATABASE_URL moves to its port and
# DIRECT_URL keeps pointing straight at postgres:5432 for migrations.
DATABASE_URL=postgresql://leetcamp:<tu-password-aquí>@postgres:5432/leetcamp
DIRECT_URL=postgresql://leetcamp:<tu-password-aquí>@postgres:5432/leetcamp

# Self-issued JWT (see docs/DECISIONS.md): this API signs AND verifies its own
# tokens, there is no external identity provider.
#
# Expected `iss` and `aud` claims. Verifying the signature without these accepts
# a token minted for a DIFFERENT deployment sharing a leaked JWT_SECRET.
AUTH_ISSUER=https://issuer.example.com
AUTH_AUDIENCE=leetcamp-api

# REQUIRED. HMAC secret, 32+ characters. Generate with `openssl rand -base64 32`
# — a DIFFERENT one than any other environment's, so a leak in one does not
# forge tokens in another.
JWT_SECRET=<genera-uno-con-openssl-rand--base64-32>

# How long an issued token stays valid, in SECONDS. Default 86400 (24h).
# JWT_TTL_SECONDS=86400


# ── Scheduler ────────────────────────────────────────────────────────────────
# ⚠⚠ MAY ONLY BE `true` ON ONE INSTANCE. The scheduler is in-process with no
# distributed coordination: every extra replica with this on runs every job one
# more time. That is data corruption, not a performance problem. See the header
# of docker-compose.yml.
SCHEDULER_ENABLED=false
SCHEDULER_BOOT_DELAY_MS=10000
SCHEDULER_HEARTBEAT_MINUTES=15
