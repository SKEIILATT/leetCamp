# ─────────────────────────────────────────────────────────────────────────────
# apps/api/.env — SERVER SECRETS AND RUNTIME CONFIGURATION
#
# Copy to `apps/api/.env` and fill it in. That file is git-ignored; NEVER commit
# it.
#
# ⚠ TRUST BOUNDARY: everything in this file is SERVER-SIDE. Nothing here may
# ever be given a client-visible prefix (`VITE_`, `NEXT_PUBLIC_`, …) or moved
# into the frontend workspace — that prefix bakes the value into the browser
# bundle where anyone can read it.
#
# Every variable here is validated at boot by `src/shared/config/env.ts`. A
# required variable that is missing, or a malformed connection string, kills the
# process at startup instead of surfacing as a 500 later.
#
# Ownership matrix per workspace: docs/ENV_VARIABLES.md
# ─────────────────────────────────────────────────────────────────────────────


# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5090
LOG_LEVEL=debug


# ── CORS ─────────────────────────────────────────────────────────────────────
# REQUIRED, no default. A default on a CORS allow-list is a silent security
# failure: deploy without setting it and the server happily accepts another
# environment's origins.
#
# CSV of exact origins. NO trailing slash — the browser's `Origin` header never
# has one, so `https://app.example.com/` would simply never match.
#
# localhost / 127.0.0.1 on any port are allowed separately by the server, so you
# do not need to list dev ports here.
CORS_ORIGINS=http://localhost:5173


# ── OpenAPI ──────────────────────────────────────────────────────────────────
# Publishes `GET /openapi`, which the frontend codegen reads.
# Double-gated: the server ALSO requires NODE_ENV != production, so setting this
# to true in a production deploy does not expose the API surface.
ENABLE_OPENAPI_ENDPOINT=true


# ── Database ─────────────────────────────────────────────────────────────────
# BOTH ARE REQUIRED AND THEY ARE NOT THE SAME CONNECTION.
#
#   DATABASE_URL → the RUNTIME connection, through the pooler in TRANSACTION
#                  mode (commonly port 6543).
#   DIRECT_URL   → the DIRECT connection, SESSION mode (commonly port 5432),
#                  used by migrations and introspection.
#
# Transaction-mode pooling does not support what migrations need (session state,
# advisory locks, DDL in long transactions). Pointing both at the pooled URL
# produces migration failures that look like corruption.
#
# ⚠ PERCENT-ENCODE THE PASSWORD. A password containing @ : / ? # breaks URL
# parsing, the string reaches the driver intact, and it fails with an
# authentication error that costs hours of looking for the wrong password. Use
# %40 %3A %2F %3F %23. The boot-time validator catches it and names the variable.
DATABASE_URL=postgresql://user:pass%40word@host:6543/postgres
DIRECT_URL=postgresql://user:pass%40word@host:5432/postgres


# ── Authentication ───────────────────────────────────────────────────────────
# Expected `iss` and `aud` claims. Both REQUIRED.
#
# ⚠ Verifying the signature alone is not enough: without an issuer and audience
# check, a valid token minted for a DIFFERENT application is accepted. That is
# why neither has a default.
AUTH_ISSUER=https://issuer.example.com
AUTH_AUDIENCE=leetcamp-api

# Optional. Derived from AUTH_ISSUER when absent. An escape hatch for pointing
# at a staging issuer or a local mock without changing code.
# AUTH_JWKS_URL=https://issuer.example.com/.well-known/jwks.json


# ── Scheduler ────────────────────────────────────────────────────────────────
# ⚠⚠ MAY ONLY BE `true` ON ONE INSTANCE. The scheduler runs in-process with no
# distributed coordination: two replicas with this on execute EVERY job TWICE.
# That is data corruption, not a performance problem, and it does not surface
# until someone reads a number that does not add up.
#
# Keep it false locally unless you are specifically testing the scheduler.
SCHEDULER_ENABLED=false

# Delay (ms) before jobs marked `runOnBoot` fire. A container in a restart loop
# must not turn ten restarts into ten runs of real work.
SCHEDULER_BOOT_DELAY_MS=10000

# Cadence (minutes) of the reference heartbeat job.
SCHEDULER_HEARTBEAT_MINUTES=15
