// Prisma schema — STARTING POINT. The `User` model exists because the auth
// plugin needs somewhere to read a role from; everything else is yours.
//
// ── THE TWO URLS ARE NOT A DUPLICATE ─────────────────────────────────────────
// `url`       → the RUNTIME connection, through the pooler in transaction mode.
// `directUrl` → the DIRECT connection, session mode, used by `migrate` and
//               `db pull`.
//
// Transaction-mode pooling does not support what migrations need: statements
// that depend on session state, advisory locks, DDL inside long transactions.
// Pointing both at the pooled URL produces migrations that fail in ways that
// look like corruption. Both are validated at boot in src/shared/config/env.ts.
//
// EN ESTE PROYECTO: self-hosted, sin pooler delante. `url` y `directUrl`
// apuntan a la MISMA instancia (ver el servicio `postgres` en
// deploy/docker-compose.yml). El comentario de arriba sigue siendo válido si
// algún día se agrega un pooler (ej. PgBouncer).

generator client {
  provider = "prisma-client-js"
  // Generated INTO src/ so tsc can see the .d.ts, and git-ignored because it is
  // an artefact. `typecheck` and `build` regenerate it, so a clean clone needs
  // to remember nothing. Committing it guarantees that one day the schema and
  // the client disagree.
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// The real product account (leetCamp self-rolled auth — see
/// docs/DECISIONS.md). Keeps the four properties the auth plugin depends on
/// (subject column, role id, activity flag, soft-delete marker) alongside the
/// fields registration/login actually need.
model User {
  id String @id @default(uuid()) @db.Uuid

  /// The auth subject (the JWT's `sub` claim this API itself issues).
  ///
  /// ⚠ SEPARATE COLUMN FROM `id` ON PURPOSE, even though tokens are
  /// self-issued and `subject` is always set equal to `id` at registration —
  /// see `apps/api/src/infrastructure/persistence/prisma-user-repository.ts`.
  /// Keeping the two columns is what lets `UserAuthorizationRepository`
  /// (`WHERE subject = $1`) stay unchanged if this project ever moves the
  /// token's `sub` away from being the application id (e.g. behind an
  /// external IdP later) — see the note on `RequestIdentity.subject`.
  subject String @unique

  email String @unique

  /// Never a plaintext password — see `@leetcamp/domain`'s `PasswordHasher`.
  passwordHash String @map("password_hash")

  /// Public name shown on the ranking, deliberately separate from `email`.
  displayName String @map("display_name")

  /// Raw role id. The number → role translation lives in the domain's
  /// `roles.ts`, which is the single source of truth shared with the frontend.
  roleId Int @map("role_id")

  /// IANA time zone (e.g. `America/Guayaquil`) — where THIS user's day starts,
  /// for streak cut-off. Per-user, not global.
  timezone String

  /// Tenants / organizations / sites in scope. leetCamp has no multi-tenancy
  /// today; always empty. Kept (rather than dropped) so
  /// `UserAuthorizationRepository`/`RequestIdentity.scopeIds` need no change
  /// if that ever becomes a requirement — an empty list means "no scope",
  /// never "all".
  scopeIds String[] @map("scope_ids")

  /// Filtered in the QUERY, never after the fact: a deactivated account that
  /// keeps working is what a forgotten post-filter looks like in production.
  status String @default("active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  createdChallenges    Challenge[]
  attempts             Attempt[]
  streak               Streak?
  passwordResetTokens  PasswordResetToken[]

  @@index([subject])
  @@map("users")
}

/// Taxonomy challenges are filed under — see the note on `CategoryRepository`
/// in @leetcamp/domain for why this is a table and not a code catalogue.
model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  challenges Challenge[]

  @@map("categories")
}

model Difficulty {
  id    String @id @default(uuid()) @db.Uuid
  name  String @unique
  /// Sort order, lower = easier. Not unique — see the domain type.
  level Int

  createdAt DateTime @default(now()) @map("created_at")

  challenges Challenge[]

  @@map("difficulties")
}

/// Fase 1 only has the prediction/analysis type — flattened onto this model
/// rather than split into a separate `PredictionChallenge` table for a `type`
/// that cannot yet be anything else. See the domain entity's header comment.
model Challenge {
  id           String @id @default(uuid()) @db.Uuid
  categoryId   String @map("category_id") @db.Uuid
  difficultyId String @map("difficulty_id") @db.Uuid

  title          String
  promptMarkdown String @map("prompt_markdown")
  codeSnippet    String @map("code_snippet")
  expectedAnswer String @map("expected_answer")

  /// `draft` | `published` — domain-validated, not a DB enum/CHECK, same
  /// convention as `User.status`: adding a status is a code change reviewed
  /// through the domain type, not a migration.
  status String @default("draft")

  createdBy String @map("created_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  category   Category   @relation(fields: [categoryId], references: [id])
  difficulty Difficulty @relation(fields: [difficultyId], references: [id])
  creator    User       @relation(fields: [createdBy], references: [id])

  dailyChallenges DailyChallenge[]

  @@index([status])
  @@map("challenges")
}

/// The single global reto del día. `date` is a pure calendar date (no
/// time-of-day, no time zone of its own) — see the domain entity's header
/// comment on `@db.Date` and the round-trip through the adapter.
model DailyChallenge {
  date        DateTime @id @db.Date
  challengeId String   @map("challenge_id") @db.Uuid
  publishedAt DateTime @map("published_at")

  /// `RESTRICT`: a challenge that is somebody's reto del día can never be
  /// deleted out from under it. There is no delete-challenge operation today,
  /// but the constraint is cheap insurance against one landing later without
  /// this exact question being asked.
  challenge Challenge @relation(fields: [challengeId], references: [id])
  attempts  Attempt[]

  @@map("daily_challenges")
}

/// One submission, one (user, day) pair — the `@@unique` below is what the
/// business rule "one attempt per day, locked after submit" actually rests
/// on. `submitAttempt` pre-checks it for a friendlier error; this constraint
/// is what makes the race between two concurrent submits impossible, not just
/// unlikely.
model Attempt {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  dailyChallengeDate DateTime @map("daily_challenge_date") @db.Date

  answer           String
  isCorrect        Boolean @map("is_correct")
  submittedAt      DateTime @map("submitted_at")
  /// `submittedAt` minus `DailyChallenge.publishedAt`, in seconds. Stored, not
  /// recomputed on read — see the domain entity's header comment.
  timeTakenSeconds Int      @map("time_taken_seconds")
  /// From `calculatePoints` — frozen at submission time against that day's
  /// difficulty level and timing. Never recomputed on read; see the domain
  /// entity's header comment on why (an admin editing a difficulty later
  /// must not rewrite history).
  ///
  /// `@default(0)` exists ONLY so this migration does not fail against rows
  /// created before this column existed (from earlier manual testing) — the
  /// application always supplies a real, computed value; nothing relies on
  /// the default going forward.
  points           Int      @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  user           User           @relation(fields: [userId], references: [id])
  dailyChallenge DailyChallenge @relation(fields: [dailyChallengeDate], references: [date])

  @@unique([userId, dailyChallengeDate])
  @@map("attempts")
}

/// One row per user. `lastAttemptDate` is the user's OWN local calendar date
/// (via `formatCalendarDate(instant, user.timezone)`), NOT
/// `Attempt.dailyChallengeDate` (which is the global UTC day) — see the
/// domain entity's header comment for why the two can legitimately differ.
model Streak {
  userId String @id @map("user_id") @db.Uuid

  currentStreak   Int      @default(0) @map("current_streak")
  longestStreak   Int      @default(0) @map("longest_streak")
  lastAttemptDate DateTime @map("last_attempt_date") @db.Date
  /// Accumulated across every correct attempt, ever. Lives on this same row
  /// rather than a separate `Ranking` table — see the domain entity's header
  /// comment for why.
  totalPoints     Int      @default(0) @map("total_points")

  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("streaks")
}

/// One issued "forgot your password" link. `tokenHash` is a SHA-256 hash of
/// the raw token that gets emailed — the raw value is never stored, only
/// what is needed to recognise it again. See the domain port's header
/// comment (`PasswordResetTokenRepository`) for why.
model PasswordResetToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  tokenHash String @unique @map("token_hash")

  expiresAt DateTime  @map("expires_at")
  /// `null` until consumed — a token is single-use, enforced by the
  /// repository checking this alongside `expiresAt`, not by deleting the
  /// row (keeping it is what stops the exact same token being replayed
  /// after the account owner already reset their password with it).
  usedAt    DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_reset_tokens")
}
